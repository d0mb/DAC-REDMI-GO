<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header / Título com Badge Online -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ DAC HUB PRO"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#162032"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ONLINE"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SELETOR DE MODO: WI-FI vs BLUETOOTH -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SELECIONE O MODO DE RECEPÇÃO:"
            android:textColor="#8094B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeWifi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#00B0FF"
                android:text="📻 MODO WI-FI (PC)"
                android:textColor="#0A0E17"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModeBluetooth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#1E2C44"
                android:text="🔵 MODO BLUETOOTH"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 1: Informações do Modo Ativo -->
        <LinearLayout
            android:id="@+id/layoutActiveModeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvActiveModeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODO WI-FI: Transmissão Lossless do Computador"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveModeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="IP do Receptor: http://192.168.15.12:8080"
                android:textColor="#FFD700"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFormatDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Qualidade: PCM 44.1kHz 16-Bit Estéreo (1411 kbps)"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <!-- VU Meter em tempo real -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="NÍVEL DE ÁUDIO DE SAÍDA (VU METER):"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbVuMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00E5FF" />
        </LinearLayout>

        <!-- CARD 2: LISTA DE DISPOSITIVOS CONECTADOS E CONTROLE DE PARADA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="DISPOSITIVOS CONECTADOS / TRANSMITINDO"
                android:textColor="#8094B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Container Dinâmico de Dispositivos -->
            <LinearLayout
                android:id="@+id/layoutDevicesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNoDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Aguardando conexão (Wi-Fi ou Bluetooth)..."
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMakeDiscoverable"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="#1E293B"
                android:text="🔍 TORNAR BLUETOOTH VISÍVEL PARA PAREAR"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 3: Volume Analógico P2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOLUME DA SAÍDA ANALÓGICA P2 (3.5mm)"
                    android:textColor="#8094B0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVolumeVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="15"
                android:progress="15"
                android:progressTint="#00E5FF"
                android:thumbTint="#00E5FF" />
        </LinearLayout>

        <!-- Botão de Tom de Teste -->
        <Button
            android:id="@+id/btnTestTone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="#00B0FF"
            android:text="🔊 TESTAR SAÍDA DE SOM NAS CAIXAS"
            android:textColor="#0A0E17"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
