<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header / Título com Badge Online -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ DAC HUB PRO"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#162032"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ONLINE"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 1: Dispositivo Transmissor Ativo (Telemetria ao Vivo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FONTE DE ÁUDIO ATIVA"
                    android:textColor="#8094B0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreamBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGUARDANDO"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectedClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aguardando Transmissão do PC..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PCM 44.1kHz • 16-Bit Lossless (1411 kbps)"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <!-- VU Meter em tempo real -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="NÍVEL DE SAÍDA (VU METER)"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbVuMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00E5FF" />
        </LinearLayout>

        <!-- CARD 2: Conexão de Rede / IP do Receptor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="ENDEREÇO DO RECEPTOR NA REDE"
                android:textColor="#8094B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvWifiIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="http://192.168.1.X:8080"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Auto-reconexão e resiliência ativas"
                android:textColor="#A0B0C0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CARD 3: Bluetooth A2DP Sink -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="RECEPTOR BLUETOOTH (A2DP SINK)"
                android:textColor="#8094B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvBtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DAC-HiFi-Audio"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pronto para pareamento de outros celulares"
                android:textColor="#00E5FF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnToggleBt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="#1E2C44"
                android:text="TORNAR VISÍVEL PARA PAREAR"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CARD 4: Controle de Volume P2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#131B2A"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SAÍDA ANALÓGICA P2 (3.5mm)"
                    android:textColor="#8094B0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVolumeVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="15"
                android:progress="15"
                android:progressTint="#00E5FF"
                android:thumbTint="#00E5FF" />
        </LinearLayout>

        <!-- Botão de Tom de Teste -->
        <Button
            android:id="@+id/btnTestTone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="#00B0FF"
            android:text="🔊 TESTAR SAÍDA DE SOM NAS CAIXAS"
            android:textColor="#0A0E17"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
